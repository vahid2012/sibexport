---
import { CONTACT } from '@/lib/site';
---

<div class="floating-contacts" aria-label="Quick contact options">
  <a
    href={CONTACT.whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with SibExport on WhatsApp"
    class="floating-btn floating-btn-whatsapp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
  </a>

  <a
    href={CONTACT.phoneUrl}
    aria-label="Call SibExport"
    class="floating-btn floating-btn-phone"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
  </a>

  <a
    href={CONTACT.emailUrl}
    aria-label="Email SibExport"
    class="floating-btn floating-btn-email"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
  </a>
</div>

<style>
  .floating-contacts {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .floating-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    color: #ffffff;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.18);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .floating-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.22);
  }

  .floating-btn:focus-visible {
    outline: 2px solid #2b5443;
    outline-offset: 2px;
  }

  .floating-btn-whatsapp {
    background-color: #25d366;
  }

  .floating-btn-whatsapp:hover {
    background-color: #1ebe5a;
  }

  .floating-btn-phone {
    background-color: #2b5443;
  }

  .floating-btn-phone:hover {
    background-color: #346852;
  }

  .floating-btn-email {
    background-color: #4b5057;
  }

  .floating-btn-email:hover {
    background-color: #26282b;
  }

  @media (max-width: 640px) {
    .floating-contacts {
      right: 0.875rem;
      bottom: 0.875rem;
    }

    .floating-btn {
      width: 3.25rem;
      height: 3.25rem;
    }

    /* Email is de-emphasized on mobile where WhatsApp and phone matter most */
    .floating-btn-email {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-btn {
      transition: none;
    }

    .floating-btn:hover {
      transform: none;
    }
  }
</style>
