---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="relative overflow-hidden bg-forest-950">
  <div
    class="absolute inset-0 opacity-[0.07]"
    style="background-image: radial-gradient(circle at 20% 30%, #E3B655 0%, transparent 45%), radial-gradient(circle at 85% 70%, #679F84 0%, transparent 50%);"
    aria-hidden="true"
  >
  </div>
  <div class="container-site relative py-14 sm:py-16 lg:py-20">
    {
      eyebrow && (
        <p class="eyebrow mb-3 text-gold-300" style="animation: fade-in 0.6s ease-out both;">
          {eyebrow}
        </p>
      )
    }
    <h1
      class="max-w-3xl text-3xl font-bold text-white sm:text-4xl lg:text-5xl"
      style="animation: fade-in-up 0.7s ease-out both;"
    >
      {title}
    </h1>
    {
      description && (
        <p
          class="mt-4 max-w-2xl text-base leading-relaxed text-forest-100 sm:text-lg"
          style="animation: fade-in-up 0.7s ease-out 0.15s both;"
        >
          {description}
        </p>
      )
    }
  </div>
</section>
