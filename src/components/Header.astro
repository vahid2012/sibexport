---
import { NAV_LINKS, SITE, CONTACT } from '@/lib/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-border/70 bg-background/95 backdrop-blur transition-shadow duration-300"
>
  <div class="container-site flex h-16 items-center justify-between gap-4 md:h-20">
    <a href="/" class="flex items-center" aria-label="SibExport home">
      <img
        src="/brand/logo-horizontal.svg"
        alt="SibExport — Iranian Apple Export"
        width="180"
        height="48"
        class="h-10 w-auto md:h-12"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main navigation">
      {
        NAV_LINKS.slice(0, 7).map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors duration-200',
              isActive(link.href)
                ? 'text-forest-700 bg-forest-50'
                : 'text-charcoal hover:bg-accent hover:text-forest-700',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/request-a-quotation/"
        class="hidden items-center gap-2 rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm transition-all duration-200 hover:bg-primary/90 hover:shadow-md md:inline-flex"
      >
        Request a Quotation
      </a>

      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-charcoal transition-colors hover:bg-accent lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg
          id="icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="12" y2="12"></line><line
            x1="4"
            x2="20"
            y1="18"
            y2="18"
          ></line></svg
        >
        <svg
          id="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
          ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
        >
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background px-4 pb-6 pt-2 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2.5 text-base font-medium transition-colors duration-200',
              isActive(link.href)
                ? 'bg-forest-50 text-forest-700'
                : 'text-charcoal hover:bg-accent hover:text-forest-700',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/request-a-quotation/"
        class="mt-3 inline-flex items-center justify-center rounded-md bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground shadow-sm"
      >
        Request a Quotation
      </a>
      <a
        href={CONTACT.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-md border border-input px-5 py-3 text-sm font-semibold text-forest-700"
      >
        WhatsApp: {CONTACT.whatsappInternational}
      </a>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (button && menu && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    button.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      setOpen(!isOpen);
    });

    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
  }
</script>
