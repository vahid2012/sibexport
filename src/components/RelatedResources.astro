---
export type ResourceLink = {
  label: string;
  href: string;
  description?: string;
};

interface Props {
  title?: string;
  intro?: string;
  links: ResourceLink[];
}

const { title = 'Related business resources', intro, links } = Astro.props;
---

<section class="container-site py-10">
  <div class="reveal rounded-xl border border-border bg-card p-7 shadow-sm sm:p-8">
    <h2 class="text-xl font-bold text-foreground">{title}</h2>
    {
      intro && <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{intro}</p>
    }
    <ul class="mt-5 grid gap-4 sm:grid-cols-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group block rounded-lg border border-border px-4 py-3.5 transition-colors duration-200 hover:bg-accent"
            >
              <span class="flex items-center gap-2 text-sm font-semibold text-forest-700">
                {link.label}
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-60 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
              </span>
              {link.description && (
                <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">
                  {link.description}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-5 text-xs leading-relaxed text-muted-foreground">
      These links point to independent third-party websites provided for
      general business reference. They are not owned or operated by SibExport.
    </p>
  </div>
</section>
