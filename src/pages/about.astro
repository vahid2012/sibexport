---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTASection from '@/components/CTASection.astro';
---

<BaseLayout
  title="About SibExport — Iranian Apple Sourcing & Export"
  description="Learn about SibExport, an Iranian apple sourcing and wholesale export business supplying premium red, golden and green apples to international buyers."
  path="/about/"
  ogImage="/images/about.png"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About SibExport' }]} />
  <PageHero
    eyebrow="About Us"
    title="Sourcing Iranian apples with export discipline"
    description="SibExport connects international fruit buyers with the apple orchards of Iran through reliable sourcing, careful grading and export-standard handling."
  />

  <section class="container-site py-14 lg:py-20">
    <div class="grid items-start gap-12 lg:grid-cols-2">
      <div class="reveal space-y-5">
        <h2 class="text-2xl font-bold sm:text-3xl">Who we are</h2>
        <p class="leading-relaxed text-muted-foreground">
          SibExport is an Iranian apple sourcing and wholesale supply business
          based in Urmia, West Azerbaijan — one of Iran's most productive apple
          regions. We work with established orchards and packing operations to
          supply fresh Iranian apples to importers, distributors and wholesale
          buyers in international markets.
        </p>
        <p class="leading-relaxed text-muted-foreground">
          Our approach is straightforward: understand the buyer's
          specification, source fruit that matches it, and manage grading,
          packing and documentation with the care a long-distance shipment
          demands.
        </p>
        <h2 class="pt-4 text-2xl font-bold sm:text-3xl">What we supply</h2>
        <p class="leading-relaxed text-muted-foreground">
          Red, golden and green apple classes in export grades, packed in
          export-standard cartons and prepared for road and sea freight to
          regional and international destinations.
        </p>
      </div>

      <div class="reveal space-y-4">
        <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
          <h3 class="text-lg font-semibold">Our operating principles</h3>
          <ul class="mt-4 space-y-3">
            {
              [
                'Honest, accurate specifications for every offer',
                'Quality checked at sourcing, packing and loading',
                'Clear communication in English at every step',
                'Documentation prepared to destination requirements',
              ].map((point) => (
                <li class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-forest-600" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-xl border border-gold-200 bg-gold-50 p-6">
          <h3 class="text-lg font-semibold">Our base</h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal-light">
            Urmia, West Azerbaijan, Iran — a region known for its cool climate,
            fertile soil and long apple-growing tradition.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
