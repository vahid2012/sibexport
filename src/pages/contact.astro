---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { CONTACT, SOCIAL } from '@/lib/site';
---

<BaseLayout
  title="Contact Us — SibExport Iranian Apple Export"
  description="Contact SibExport for Iranian apple export inquiries: WhatsApp, phone, email and office address in Urmia, West Azerbaijan, Iran."
  path="/contact/"
  ogImage="/images/contact.png"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact Us' }]} />
  <PageHero
    eyebrow="Contact"
    title="Get in touch with SibExport"
    description="WhatsApp is the fastest way to reach our team. We are also available by phone and email for quotations and general inquiries."
  />

  <section class="container-site py-14 lg:py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href={CONTACT.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal group rounded-xl border border-border bg-card p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
      >
        <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[#25d366]/10 text-[#1ebe5a]">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </div>
        <h2 class="mt-5 text-lg font-semibold">WhatsApp</h2>
        <p class="mt-1 text-sm text-muted-foreground">{CONTACT.whatsappInternational}</p>
        <p class="mt-1 text-xs text-muted-foreground">Local: {CONTACT.whatsappNational}</p>
        <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-forest-700">
          Chat now
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </span>
      </a>

      <a
        href={CONTACT.phoneUrl}
        class="reveal group rounded-xl border border-border bg-card p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
      >
        <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-forest-50 text-forest-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </div>
        <h2 class="mt-5 text-lg font-semibold">Telephone</h2>
        <p class="mt-1 text-sm text-muted-foreground">{CONTACT.phoneInternational}</p>
        <p class="mt-1 text-xs text-muted-foreground">Local: {CONTACT.phoneNational}</p>
        <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-forest-700">
          Call us
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </span>
      </a>

      <a
        href={CONTACT.emailUrl}
        class="reveal group rounded-xl border border-border bg-card p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
      >
        <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-gold-50 text-gold-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
        </div>
        <h2 class="mt-5 text-lg font-semibold">Email</h2>
        <p class="mt-1 text-sm text-muted-foreground">{CONTACT.email}</p>
        <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-forest-700">
          Write to us
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </span>
      </a>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="reveal rounded-xl border border-border bg-card p-7 shadow-sm">
        <h2 class="text-lg font-semibold">Office address</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          {CONTACT.address}
        </p>
        <div class="mt-5 rounded-lg border border-border bg-secondary/60 p-4">
          <p class="text-xs leading-relaxed text-muted-foreground">
            Visits are by appointment. Please contact us in advance to arrange
            a meeting at our office.
          </p>
        </div>
      </div>

      <div class="reveal rounded-xl border border-border bg-card p-7 shadow-sm">
        <h2 class="text-lg font-semibold">Follow us</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Connect with SibExport on social media for orchard and product updates.
        </p>
        <div class="mt-5 flex flex-col gap-3">
          <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-lg border border-border px-4 py-3 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-accent">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-forest-700" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            Facebook
          </a>
          <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-lg border border-border px-4 py-3 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-accent">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-forest-700" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
            Instagram — @iran.sourcing.hub
          </a>
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 rounded-lg border border-border px-4 py-3 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-accent">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-forest-700" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
