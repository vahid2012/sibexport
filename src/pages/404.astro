---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { NAV_LINKS } from '@/lib/site';
---

<BaseLayout
  title="Page Not Found | SibExport"
  description="The page you are looking for could not be found. Explore SibExport's Iranian apple export pages."
  noindex

  ogImage="/images/notfound.png">
  <section class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold sm:text-5xl">This page has moved on</h1>
    <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted-foreground sm:text-base">
      The page you are looking for could not be found. It may have been moved
      or renamed — try one of the pages below instead.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      {
        NAV_LINKS.slice(1, 6).map((link) => (
          <a
            href={link.href}
            class="rounded-full border border-input bg-background px-5 py-2.5 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-accent hover:text-forest-700"
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</BaseLayout>
