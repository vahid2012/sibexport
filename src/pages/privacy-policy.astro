---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE, CONTACT } from '@/lib/site';
---

<BaseLayout
  title="Privacy Policy | SibExport"
  description="How SibExport handles the information you share through sibexport.ir, including quotation requests and contact inquiries."
  path="/privacy-policy/"
  ogImage="/images/privacy.png"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} />

  <article class="container-site max-w-3xl py-14 lg:py-20">
    <h1 class="text-3xl font-bold sm:text-4xl">Privacy Policy</h1>
    <p class="mt-3 text-sm text-muted-foreground">Last updated: November 2026</p>

    <div class="mt-10 space-y-8 text-sm leading-relaxed text-muted-foreground sm:text-base">
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-foreground">1. Who we are</h2>
        <p>
          SibExport ("we", "us") is an Iranian apple sourcing, wholesale supply
          and export business based in Urmia, West Azerbaijan, Iran, operating
          the website {SITE.domain}. This policy explains how we handle
          information you share with us through this website.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-foreground">2. Information we collect</h2>
        <p>
          When you contact us or request a quotation, you may choose to share:
        </p>
        <ul class="list-disc space-y-1.5 pl-6">
          <li>Your name and company name</li>
          <li>Your email address and contact details</li>
          <li>Your destination country or market</li>
          <li>Details of your product requirements (variety, volume, packing)</li>
        </ul>
        <p>
          This website is static and does not store your form submissions on
          the site itself. Details you submit are delivered directly to us via
          the contact channel you choose (WhatsApp or email).
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-foreground">3. How we use your information</h2>
        <p>We use the information you share solely to:</p>
        <ul class="list-disc space-y-1.5 pl-6">
          <li>Respond to your inquiry or quotation request</li>
          <li>Prepare offers and manage ongoing trade discussions</li>
          <li>Communicate with you about your orders and shipments</li>
        </ul>
        <p>
          We do not sell, rent or share your information with third parties
          for marketing purposes.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-foreground">4. Cookies and analytics</h2>
        <p>
          This website does not use advertising cookies or cross-site tracking.
          If basic privacy-respecting analytics are added in the future, this
          policy will be updated accordingly.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-foreground">5. Third-party services</h2>
        <p>
          Our website links to third-party services such as WhatsApp, Facebook,
          Instagram and LinkedIn. When you follow those links, those platforms'
          own privacy policies apply to your use of them.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-foreground">6. Data retention</h2>
        <p>
          We retain correspondence and quotation records for as long as needed
          to serve our business relationship and to meet legal or accounting
          obligations. You may ask us to delete correspondence at any time.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-foreground">7. Your rights</h2>
        <p>
          You may contact us at any time to request access to, correction of,
          or deletion of the personal information you have shared with us.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-foreground">8. Changes to this policy</h2>
        <p>
          We may update this policy from time to time. The current version will
          always be published on this page.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-foreground">9. Contact</h2>
        <p>
          For any privacy question, contact us at
          <a href={CONTACT.emailUrl} class="font-medium text-forest-700 underline underline-offset-2">{CONTACT.email}</a>,
          by phone at
          <a href={CONTACT.phoneUrl} class="font-medium text-forest-700 underline underline-offset-2">{CONTACT.phoneInternational}</a>,
          or by post at: {CONTACT.address}
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
